<?xml version="1.0" encoding="utf-8"?>
<!--
  A widget story title, in the phone's font. It's a plain TextView so the widget can make it bold
  with a paint flag (see storyText in StoriesWidget.kt): phone fonts without a bold weight ignore
  both Glance's FontWeight.Bold and textStyle="bold", and some phones replace any fontFamily too.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="2" />
