<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_story_meta.xml for the Transparent theme, with a soft shadow so the small grey line reads
  on any wallpaper. A widget can't set a shadow from code, so it needs its own layout. Keep in step
  with widget_story_meta.xml and the preview's shadow in WidgetConfigActivity.kt.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="@font/jetbrains_mono_regular"
    android:maxLines="1"
    android:shadowColor="#B3000000"
    android:shadowDy="1"
    android:shadowRadius="4" />
