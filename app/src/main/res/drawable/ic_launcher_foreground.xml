<?xml version="1.0" encoding="utf-8"?>
<!-- The "hn²" monogram, drawn as strokes. Also used as the Android 13+ themed (monochrome) icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled to 70% around the mark's center so it sits inside the 66dp safe zone. -->
    <group
        android:pivotX="58.5"
        android:pivotY="55"
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="-4.5"
        android:translateY="-1">
        <!-- h and n -->
        <path
            android:pathData="M30,36 V72 M30,57 a9,9 0 0 1 18,0 V72 M60,48 V72 M60,57 a9,9 0 0 1 18,0 V72"
            android:strokeWidth="9"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- superscript 2 -->
        <path
            android:pathData="M84,40.5 a4.5,4.5 0 0 1 9,0 c0,3 -2,4.5 -4.5,7 L84,51 H93"
            android:strokeWidth="5"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
